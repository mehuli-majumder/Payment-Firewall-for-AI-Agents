# Copy to .env and fill in. A Razorpay test key pair works as-is:
# dashboard.razorpay.com -> Settings -> API Keys -> Generate Test Key
FIREWALL_LIVE_RAIL_URL=https://api.razorpay.com/v1/orders
FIREWALL_LIVE_RAIL_USER=rzp_test_xxxxxxxxxxxxxx
FIREWALL_LIVE_RAIL_PASS=xxxxxxxxxxxxxxxxxxxxxxxx
FIREWALL_LIVE_RAIL_TIMEOUT=8

# Stripe test mode works too, same shape:
# FIREWALL_LIVE_RAIL_URL=https://api.stripe.com/v1/payment_intents
# FIREWALL_LIVE_RAIL_USER=sk_test_xxxxxxxxxxxx
# FIREWALL_LIVE_RAIL_PASS=
